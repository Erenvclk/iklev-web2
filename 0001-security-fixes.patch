From 9db2ff615bc436105a77d78a7782edded8162f67 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 16 Aug 2026 15:45:28 +0000
Subject: [PATCH] security: fix conflicting headers, patch Next.js, upgrade
 Sanity v3->v6, harden GROQ query

- Remove vercel.json (conflicting/stale CSP, CORS, X-Frame-Options duplicated with next.config.ts)
- Upgrade next 16.2.6 -> 16.2.12 (fixes SSRF in Server Actions/rewrites, DoS, unauthenticated internal endpoint disclosure)
- Upgrade sanity 3.99 -> 6.9.2 and next-sanity 9.12 -> 13.3.3 (32 -> 11 npm audit vulns, 0 critical)
- getRecentHaberler: coerce count to safe integer before GROQ interpolation instead of raw template injection
---
 lib/queries.ts    |     6 +-
 package-lock.json | 12452 +++++++++++++++++++++-----------------------
 package.json      |     6 +-
 vercel.json       |    29 -
 4 files changed, 5959 insertions(+), 6534 deletions(-)
 delete mode 100644 vercel.json

diff --git a/lib/queries.ts b/lib/queries.ts
index 26265a2..329f3ec 100644
--- a/lib/queries.ts
+++ b/lib/queries.ts
@@ -31,8 +31,12 @@ export async function getHaberler(): Promise<Haber[]> {
 }
 
 export async function getRecentHaberler(count = 3): Promise<Haber[]> {
+  // GROQ slice sınırları (`[0...N]`) parametre kabul etmez, sabit sayı olmalıdır.
+  // Bu yüzden count'u sorguya koymadan önce güvenli bir tamsayıya zorluyoruz;
+  // böylece bu değer hiçbir zaman doğrulanmamış bir string olarak sorguya giremez.
+  const safeCount = Number.isInteger(count) && count > 0 ? Math.min(count, 50) : 3;
   return sanityClient.fetch(
-    `*[_type == "haber"] | order(yayinTarihi desc) [0...${count}] { ${haberListeFields} }`
+    `*[_type == "haber"] | order(yayinTarihi desc) [0...${safeCount}] { ${haberListeFields} }`
   );
 }
 
